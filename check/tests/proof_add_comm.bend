# theorems: add_comm over a local Nat -- two lemmas (add_zero, add_succ),
# stacked rewrites, and the recursive call as the induction hypothesis.
# ported from bend3: rewrites carry explicit motives; add_succ is stated
# with the term each rewrite eliminates on the right; b's double spend
# rides a +b Cop binder over the local N.copy witness

import Base
type N:
  Z{}
  S{p: N}

assert N.copy:
  forall t: N
  Copy(N, t) & Copy(N, t)

def N.copy(t):
  match t:
    case Z{}:
      ((Z{}, {==}), (Z{}, {==}))
    case S{p}:
      ((px, pe), (py, pf)) = N.copy(p)
      s10 = Equal.cong(N, N, z => S{z}, p, px, pe)
      s20 = Equal.cong(N, N, z => S{z}, p, py, pf)
      ((S{px}, s10), (S{py}, s20))

assert add:
  forall a: N
  forall b: N
  N

def add(a, b):
  match a:
    case Z{}:
      b
    case S{p}:
      S{add(p, b)}

assert add_zero:
  forall a: N
  {add(a, Z{}) == a : N}

def add_zero(a):
  match a:
    case Z{}:
      {==}
    case S{p}:
      %add_zero(p) : {S{add(p, Z{})} == S{_} : N}
      {==}

assert add_succ:
  forall a: N
  forall -b: N
  {S{add(a, b)} == add(a, S{b}) : N}

def add_succ(a, b):
  match a:
    case Z{}:
      {==}
    case S{p}:
      %add_succ(p, b) : {S{S{add(p, b)}} == S{_} : N}
      {==}

assert add_comm:
  forall a: N
  forall +b: +N
  {add(a, b) == add(b, a) : N}

def add_comm(a, b):
  match a:
    case Z{}:
      %add_zero(b) : {_ == add(b, Z{}) : N}
      {==}
    case S{p}:
      %add_succ(b, p) : {S{add(p, b)} == _ : N}
      %add_comm(p, b) : {S{add(p, b)} == S{_} : N}
      {==}

assert main:
  {add(S{S{Z{}}}, S{Z{}}) == add(S{Z{}}, S{S{Z{}}}) : N}

def main(): add_comm(S{S{Z{}}}, S{Z{}})

$$ bend %
{==}
