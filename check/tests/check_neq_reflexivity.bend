# {==} proves reflexivity, never {a != a}: bend4's inequality desugars
# at parse to the arrow {a == b : T} -> Empty (bend3's Empty.Not law,
# structurally), so Rfl rejects it on shape
import Base

assert neg:
  Type

def neg():
  {0 != 0 : U32}

assert prf:
  neg()

def prf():
  {==}

assert main:
  U32

def main():
  0
