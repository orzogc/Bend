# ported from bend3: compiled F32 printing inside a constructor. bend4
# rules float text out, and nan/inf/exponent spellings have no literal
# surface, so the boxed walk respells to plain literals: the C emitter
# refuses the float-holding ctor as unshowable and runtime.js prints
# raw JS numbers (2 for 2.0: the ".0" integer tail of bend3's
# parseable-spelling ruling is not kept).
import Base

type FV:
  FV{a: F32, b: F32, c: F32}

assert main:
  FV

def main():
  FV{2.0, 0.5, 0.1}
