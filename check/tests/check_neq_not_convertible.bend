# conversion must not equate {a != b} with {a == b}: bend4's
# inequality is the arrow into Empty from parse time, never
# convertible with the equation itself
import Base

assert neg:
  Type

def neg():
  {0 != 0 : U32}

assert coerce:
  forall p: neg()
  {0 == 0 : U32}

def coerce(p):
  p

assert main:
  U32

def main():
  0
