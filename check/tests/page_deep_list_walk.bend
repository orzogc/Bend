# a proof error whose fields hold a computed 6000-deep chain must
# still print its error page (depth unbounded by source never kills a
# page; 6000 keeps 2x headroom under the JS stack)
# ported from bend3: U32 index -> Nat; headless chain (a U32 head
# prints as a 32-deep Word chain, bloating the golden without adding
# depth)
import Base
type L:
  LC{tail: L}
  LN{}

assert build:
  forall n: Nat
  L

def build(n):
  match n:
    case 0n:
      LN{}
    case 1n+n:
      LC{build(n)}

assert thm:
  {build(6000n) == LN{} : L}

def thm():
  {==}

$$ bend %
Error:
