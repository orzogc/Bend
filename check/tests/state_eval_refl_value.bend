# float literals are definitionally transparent: two spellings of the
# same build meet by refl in a dead (type-level) position -- the F32 ops stay stuck axioms and equality is syntactic
import Base

assert prf:
  {1.5 == 1.5 : F32}

def prf():
  {==}

assert main:
  Type

def main():
  {1.5 == 1.5 : F32}
