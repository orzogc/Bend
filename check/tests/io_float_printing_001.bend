# ported from bend3: the pure word-main print path. bend3 ruled ONE
# printing path, mirrored and parseable; bend4 rules float TEXT out
# (floats are literals + infix sugar only): the C emitter refuses a
# float main as unshowable, the interpreter shows the stuck axiom
# spelling, and runtime.js prints the raw JS number -- which for 1/3
# is bend3's exact shortest round-trip digits.
import Base

assert main:
  F32

def main():
  1.0 /. 3.0
$$ bend %
