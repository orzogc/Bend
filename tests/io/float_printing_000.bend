# a compiled F32 inside a constructor: a bare F32 main is no IO, so
# the compiled lanes refuse it and the interpreter shows the fields as
# the binary32 words they are
import Base

type FV is Data:
  FV{a: F32, b: F32, c: F32}

law main:
  FV

def main():
  FV{2.0, 0.5, 0.1}

